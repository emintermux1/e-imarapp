# Environment variables for eImarTR application

# Database settings
DATABASE_URL=postgresql+asyncpg://eimar:eimar@localhost:5432/eimar

# Redis settings
REDIS_URL=redis://localhost:6379/0

# Map provider API keys (optional)
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
CESIUM_ION_TOKEN=
HERE_API_KEY=

# JWT settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External service URLs
TKGM_PARSEL_SORGU_URL=https://parselsorgu.tkgm.gov.tr/
EPLAN_BASE_URL=https://eplan.csb.gov.tr/