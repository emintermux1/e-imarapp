# Environment variables for eImarTR application
# Allowed: development | test | production
NODE_ENV=development
# HTTP listen port
PORT=3000

# Core infrastructure URLs
# NestJS/TypeORM style:
DATABASE_URL=postgres://username:password@localhost:5432/eimar
# FastAPI/SQLAlchemy async style:
# DATABASE_URL=postgresql+asyncpg://eimar:eimar@localhost:5432/eimar
REDIS_URL=redis://localhost:6379
# Start the read-only geo integrity worker locally with:
# npm run worker:geo-integrity
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
OPENSEARCH_URL=http://localhost:9200
PG_TILESERV_URL=http://localhost:7800
PUSH_GATEWAY_URL=
WEBSITE_SESSION_SECRET=
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_EIMAR_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EIMAR_DATA_MODE=api
NEXT_PUBLIC_EIMAR_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_EIMAR_VECTOR_TILE_URL=
NEXT_PUBLIC_EIMAR_ENABLE_DEMO_FALLBACK=0

# Optional provider/API credentials. Fill via .env or a secret manager; never commit real values.
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
CESIUM_ION_TOKEN=
HERE_API_KEY=
# Browser-facing map keys (Next.js). Use domain-restricted public tokens where possible.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_HERE_API_KEY=
TKGM_LEGAL_AGREEMENT_REF=
TKGM_SESSION_REF=
MAKS_LEGAL_AGREEMENT_REF=
MAKS_CREDENTIALS_REF=
EDEVLET_TUCBS_CREDENTIALS_REF=
EDEVLET_TUCBS_OAUTH_REF=
COPERNICUS_OAUTH_REF=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# JWT settings (used by FastAPI backend)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External service URLs
TKGM_PARSEL_SORGU_URL=https://parselsorgu.tkgm.gov.tr/
EPLAN_BASE_URL=https://eplan.csb.gov.tr/
