# E-İmar local development configuration
APP_ENV=development

# Optional: app runs with premium mock map when absent
MAPBOX_ACCESS_TOKEN=

# Optional Firebase web values; native apps should use FlutterFire generated options later
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=e-imar-dev
FIREBASE_STORAGE_BUCKET=e-imar-dev.appspot.com

# E-İmar live data gateway used by the mobile app. For local Functions emulator:
# http://127.0.0.1:5001/<firebase-project-id>/europe-west1/api
E_IMAR_GATEWAY_BASE_URL=
E_IMAR_GATEWAY_TURKEY_ONLY=true
E_IMAR_PUBLIC_MUNICIPAL_GIS_ENABLED=true
E_IMAR_PUBLIC_CITY_MAP_ENABLED=true
E_IMAR_EPLAN_PROVIDER_ENABLED=true
E_IMAR_RESTRICTED_TKGM_PROVIDER_ENABLED=false

# Firebase Functions gateway runtime configuration
GATEWAY_TURKEY_ONLY=true
MUNICIPAL_GIS_PROVIDERS_JSON=
IBB_CITY_MAP_PROVIDER_ENABLED=true
IBB_CITY_MAP_API_KEY=
EPLAN_PROVIDER_ENABLED=true
TKGM_PROVIDER_ENABLED=false
TKGM_PROVIDER_BASE_URL=
TKGM_PERMISSION_REFERENCE=
TKGM_API_KEY=

# Optional AI integrations; mock services are used when absent
OPENAI_API_KEY=
GROK_API_KEY=

# Optional ethical market-data integrations
SAHIBINDEN_PARTNER_TOKEN=
EMLAKJET_PARTNER_TOKEN=
HEPSIEMLAK_PARTNER_TOKEN=
