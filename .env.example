# Environment variables for eImarTR application
# Allowed: development | test | production
NODE_ENV=development
# HTTP listen port
PORT=3000

# Core infrastructure URLs
# NestJS/TypeORM style:
DATABASE_URL=postgres://username:password@localhost:5432/eimar
# FastAPI/SQLAlchemy async style:
# DATABASE_URL=postgresql+asyncpg://eimar:eimar@localhost:5432/eimar
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
OPENSEARCH_URL=http://localhost:9200
PG_TILESERV_URL=http://localhost:7800
PUSH_GATEWAY_URL=
WEBSITE_SESSION_SECRET=

# Optional provider/API credentials. Fill via .env or a secret manager; never commit real values.
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
CESIUM_ION_TOKEN=
HERE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# JWT settings (used by FastAPI backend)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External service URLs
TKGM_PARSEL_SORGU_URL=https://parselsorgu.tkgm.gov.tr/
EPLAN_BASE_URL=https://eplan.csb.gov.tr/
