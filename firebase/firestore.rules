rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if owns(userId);
      allow delete: if false;

      match /favorites/{favoriteId} {
        allow read, write: if owns(userId);
      }

      match /savedSearches/{searchId} {
        allow read, write: if owns(userId);
      }

      match /followedParcels/{parcelId} {
        allow read, write: if owns(userId);
      }

      match /notifications/{notificationId} {
        allow read, update: if owns(userId);
        allow create, delete: if false;
      }
    }

    match /publicConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
